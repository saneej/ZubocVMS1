rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Orders collection for VMS packing evidence
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId);
      allow delete: if false;
    }

    // Settings document for Telegram Bot configuration
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Staffs collection for staff management & authentication
    match /staffs/{staffId} {
      allow read, write: if true;
    }
  }
}
